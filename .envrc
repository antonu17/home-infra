# Commit this file. Keep credentials and machine-specific settings in .envrc.local.
source_env_if_exists .envrc.local

# Vault Terraform root-module inputs. Never print these environment variables.
export TF_VAR_vault_address="${VAULT_ADDR:-${TF_VAR_vault_address:-}}"
export TF_VAR_vault_token="${VAULT_TOKEN:-${TF_VAR_vault_token:-}}"
export TF_VAR_kubernetes_host="${VAULT_KUBERNETES_HOST:-https://k8s.home.antonu.org:6443}"
export TF_VAR_kubernetes_ca_cert="${TF_VAR_kubernetes_ca_cert:-}"
export TF_VAR_kubernetes_token_reviewer_jwt="${TF_VAR_kubernetes_token_reviewer_jwt:-}"
if [ -z "${TF_VAR_kubernetes_ca_cert:-}" ] && [ -n "${VAULT_KUBERNETES_CA_FILE:-}" ] && [ -r "$VAULT_KUBERNETES_CA_FILE" ]; then
  watch_file "$VAULT_KUBERNETES_CA_FILE"
  export TF_VAR_kubernetes_ca_cert="$(cat "$VAULT_KUBERNETES_CA_FILE")"
fi
if [ -z "${TF_VAR_kubernetes_token_reviewer_jwt:-}" ] && [ -n "${VAULT_KUBERNETES_REVIEWER_JWT_FILE:-}" ] && [ -r "$VAULT_KUBERNETES_REVIEWER_JWT_FILE" ]; then
  watch_file "$VAULT_KUBERNETES_REVIEWER_JWT_FILE"
  export TF_VAR_kubernetes_token_reviewer_jwt="$(cat "$VAULT_KUBERNETES_REVIEWER_JWT_FILE")"
fi

# Terraform state on a mounted NAS share. Paths are machine-local settings.
# Keep other homelab tooling usable before the backend has been configured.
if [ -n "${TF_STATE_MOUNT:-}" ] || [ -n "${TF_STATE_PATH:-}" ]; then
  if ! python3 - "$TF_STATE_MOUNT" "$TF_STATE_PATH" <<'PY_CHECK'
import os
from pathlib import Path
import sys
mount, state = map(Path, sys.argv[1:])
if not (mount.is_absolute() and state.is_absolute() and os.path.ismount(mount)):
    raise SystemExit("Terraform state: configure an absolute NAS mount and state path; mount the share first.")
try:
    state.resolve().relative_to(mount.resolve())
except ValueError:
    raise SystemExit("Terraform state: the state file must be inside the configured NAS mount.")
if not state.parent.is_dir() or not os.access(state.parent, os.W_OK):
    raise SystemExit("Terraform state: create a writable private state directory on the NAS share first.")
PY_CHECK
  then
    return 1
  fi
  # Quote paths so Terraform also handles mounted-share names containing spaces.
  export TF_CLI_ARGS_init="-backend-config=path=\"$TF_STATE_PATH\""
  # This SMB state share rejects POSIX locks; use one Terraform writer at a time.
  export TF_CLI_ARGS_plan="${TF_CLI_ARGS_plan:+$TF_CLI_ARGS_plan }-lock=false"
  export TF_CLI_ARGS_apply="${TF_CLI_ARGS_apply:+$TF_CLI_ARGS_apply }-lock=false"
fi
