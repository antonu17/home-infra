.DS_Store

# Generated Talos machine configurations contain cluster credentials.
/talos/generated/
/talos/secrets/
/.private/

# Kustomize's Helm inflator downloads charts here while rendering.
/kubernetes/*/charts/

# Machine-local direnv settings and credentials.
/.envrc.local

# Image Factory runtime signing identity and private Compose environment.
/synology/talos-image-factory/**/*.key
/synology/talos-image-factory/.env
/synology/talos-image-factory/**/.cache-signing-key.*
