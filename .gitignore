.DS_Store

# Generated Talos machine configurations contain cluster credentials.
/talos/generated/
/talos/secrets/
/kubernetes/storage/synology-csi/secret/
/kubernetes/cert-manager/charts/
/.private/

# Kustomize's Helm inflator downloads charts here while rendering.
/kubernetes/*/charts/

# Machine-local direnv settings and credentials.
/.envrc.local
