# One import block keeps local variables in scope across commands.
:do {
    :local phase "preflight"
    :onerror failure in={
        # Upstream Pi-hole image pulled directly from Docker Hub onto built-in flash.
        # Stop pihole before repeat imports. No repull, root replacement or secret in Git.
        :set phase "container package"
        :if ([:len [/system package find where name="container" and disabled=no]] != 1) do={ :error "Container package required" }
        :set phase "container device mode"
        :if ([/system device-mode get container] != true) do={ :error "Container device mode required" }
        :set phase "CPU architecture"
        :if ([/system resource get architecture-name] != "arm64") do={ :error "Pi-hole requires ARM64" }
        # Match the existing Tailscale persistent-flash path convention.
        :local prefix ""
        :if ([:len [/file find where name="flash" and type="directory"]] = 1) do={ :set prefix "flash/" }
        :local root ($prefix . "containers/pihole")
        :local data ($prefix . "volumes/pihole")
        :local tmp ($prefix . "containers/pihole-tmp")
        :local reserve 67108864
        :set phase "flash capacity"
        :if ([/system resource get free-hdd-space] < $reserve) do={ :error "Keep at least 64MiB of internal flash free" }
        :if ([:len [/interface veth find where name="veth-pihole"]] != 1) do={ :error "Import file20 first" }
        # Query state flags directly; print maps are not a stable state interface.
        :local containerState do={
            :foreach match in=[/container find where stopped] do={
                :if ([:tostr $match] = [:tostr $id]) do={ :return "stopped" }
            }
            :foreach match in=[/container find where running] do={
                :if ([:tostr $match] = [:tostr $id]) do={ :return "running" }
            }
            :foreach match in=[/container find where healthy] do={
                :if ([:tostr $match] = [:tostr $id]) do={ :return "running" }
            }
            :return "busy"
        }
        :set phase "container inventory"
        :local existing [/container find where name="pihole"]
        :if ([:len $existing] > 1) do={ :error "Duplicate Pi-hole container" }
        :if ([:len $existing] = 0) do={
            # Conservative initial download/extraction budget; not a measured footprint.
            :if ([/system resource get free-hdd-space] < 268435456) do={ :error "Keep at least 256MiB free for initial Pi-hole pull/extraction" }
            # Registry and tmpdir are shared settings; do not change them during a pull.
            :foreach instance in=[/container find] do={
                :set phase "container runtime state"
                :local status [$containerState id=$instance]
                :if ($status = "busy") do={ :error "Wait for other container transitions/downloads/extraction to finish" }
            }
        } else={
            :set phase "Pi-hole stopped state"
            :if ([$containerState id=$existing] != "stopped") do={ :error "Stop Pi-hole and wait before re-importing file21" }
            :set phase "Pi-hole interface"
            :if ([/container get $existing interface] != "veth-pihole") do={ :error "Unexpected Pi-hole interface" }
            :set phase "Pi-hole mountlists"
            :if ([/container get $existing mountlists] != "pihole-data") do={ :error "Unexpected Pi-hole mounts; preserve data" }
            :set phase "Pi-hole root-dir"
            :local existingRoot [/container get $existing root-dir]
            :if (($existingRoot != $root) && ($existingRoot != ("/" . $root))) do={ :error "Unexpected Pi-hole root; preserve data" }
        }
        :set phase "data mount inventory"
        :local mount [/container mounts find where list="pihole-data"]
        :if ([:len $mount] > 1) do={ :error "Duplicate Pi-hole data mount" }
        :if ([:len $mount] = 1) do={
            :set phase "data mount destination"
            :if ([/container mounts get $mount dst] != "/etc/pihole") do={ :error "Unexpected Pi-hole mount destination" }
            :set phase "data mount source"
            :local source [/container mounts get $mount src]
            :if (($source != $data) && ($source != ("/" . $data))) do={ :error "Unexpected Pi-hole mount source" }
        }
        # Managed environment contains only non-secret desired settings. Password is
        # generated by Pi-hole and persisted in /etc/pihole; logging stays off.
        # RouterOS owns the host clock; disable container NTP client/server.
        # Disable on-disk query history and per-query text logs to reduce flash writes.
        :set phase "local DNS dependency"
        :if ([:tostr [/ip dns get servers]] != "1.1.1.1") do={ :error "Import 20-pihole-prepare-dns.rsc before configuring conditional forwarding" }
        :if ([/ip dns get use-doh-server] != "") do={ :error "Import 20-pihole-prepare-dns.rsc to clear RouterOS DoH" }
        # RouterOS owns infrastructure, ExternalDNS application records and reverse DNS.
        :local settings {"TZ"="Europe/Berlin";"FTLCONF_ntp_sync_active"="false";"FTLCONF_ntp_ipv4_active"="false";"FTLCONF_ntp_ipv6_active"="false";"DNSMASQ_USER"="root";"FTLCONF_dns_listeningMode"="ALL";"FTLCONF_dns_upstreams"="1.1.1.1";"FTLCONF_dns_revServers"="true,192.168.100.0/24,172.31.254.1,home.antonu.org;true,192.168.200.0/24,172.31.254.1;true,192.168.30.0/24,172.31.254.1;true,192.168.40.0/24,172.31.254.1;true,192.168.88.0/24,172.31.254.1;true,10.40.0.0/24,172.31.254.1";"FTLCONF_dns_rateLimit_count"="1000";"FTLCONF_dns_rateLimit_interval"="60";"FTLCONF_webserver_domain"="pihole.home.antonu.org";"FTLCONF_webserver_port"="80r,443s";"FTLCONF_webserver_tls_cert"="/etc/pihole/tls.pem";"FTLCONF_webserver_tls_validity"="0";"FTLCONF_database_maxDBdays"="0";"FTLCONF_files_log_dnsmasq"="/dev/null"}
        :set phase "environment validation/reconciliation"
        :foreach envKey,envValue in=$settings do={
            :if ([:len [/container envs find where list="pihole-env" and key=$envKey]] > 1) do={ :error "Duplicate Pi-hole environment key" }
        }
        :set phase "environment validation/reconciliation"
        :foreach envKey,envValue in=$settings do={
            :local env [/container envs find where list="pihole-env" and key=$envKey]
            :if ([:len $env] = 0) do={
                :set phase "environment add"
                /container envs add list=pihole-env key=$envKey value=$envValue disabled=no
            } else={
                :set phase "environment set"
                /container envs set $env list=pihole-env key=$envKey value=$envValue disabled=no
            }
        }
        :if ([:len $mount] = 0) do={
            :set phase "data mount creation"
            /container mounts add list=pihole-data src=$data dst=/etc/pihole
        }
        :if ([:len $existing] = 0) do={
            :set phase "registry configuration"
            /container/config set registry-url=https://registry-1.docker.io tmpdir=$tmp
            :set phase "container creation"
            /container add name=pihole remote-image=pihole/pihole:2026.10.0 interface=veth-pihole root-dir=$root mountlists=pihole-data envlists=pihole-env dns=1.1.1.1 user=0:0 start-on-boot=yes logging=no memory-high=268435456 memory-max=402653184 comment="Router-local Pi-hole DNS"
        } else={
            :set phase "container reconciliation"
            /container set $existing remote-image=pihole/pihole:2026.10.0 interface=veth-pihole mountlists=pihole-data envlists=pihole-env dns=1.1.1.1 user=0:0 start-on-boot=yes logging=no memory-high=268435456 memory-max=402653184 comment="Router-local Pi-hole DNS"
        }
        :set phase "environment attachment verification"
        :local configured [/container find where name="pihole"]
        :if ([/container get $configured envlists] != "pihole-env") do={ :error "Pi-hole environment list is not attached" }
        # Start the container after extraction completes. Re-import preserves image and data.
    } do={ :error ("Pi-hole " . $phase . ": " . $failure) }
}
